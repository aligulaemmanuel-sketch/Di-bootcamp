generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GroupRole {
  ADMIN
  TREASURER
  MEMBER
}

enum PaymentMethod {
  MPESA
  BANK
  CASH
}

enum LoanStatus {
  PENDING
  APPROVED
  DECLINED
}

enum LedgerSide {
  DEBIT
  CREDIT
}

enum LedgerAccount {
  GROUP_CASH
  MEMBER_CONTRIBUTIONS
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String
  createdAt     DateTime       @default(now())
  memberships   GroupMember[]
  contributions Contribution[] @relation("RecordedContributions")
  loanDecisions Loan[]         @relation("LoanDecisions")
  auditEvents   AuditEvent[]
}

model Group {
  id            String              @id @default(uuid())
  name          String
  currency      String              @default("KES")
  createdAt     DateTime            @default(now())
  members       GroupMember[]
  contributions Contribution[]
  loans         Loan[]
  savingsGoals  SavingsGoal[]
  ledger        LedgerTransaction[]
  auditEvents   AuditEvent[]
}

model GroupMember {
  id            String         @id @default(uuid())
  groupId       String
  userId        String?
  name          String
  phone         String
  role          GroupRole      @default(MEMBER)
  joinedAt      DateTime       @default(now())
  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  contributions Contribution[]
  loans         Loan[]
  savingsGoals  SavingsGoal[]

  @@unique([groupId, phone])
  @@index([groupId, name])
  @@index([userId])
}

model Contribution {
  id             String        @id @default(uuid())
  groupId        String
  memberId       String
  savingsGoalId  String?
  recordedById   String
  amountMinor    BigInt
  method         PaymentMethod
  reference      String        @unique
  idempotencyKey String        @unique
  note           String?
  createdAt      DateTime      @default(now())
  group          Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  member         GroupMember   @relation(fields: [memberId], references: [id], onDelete: Restrict)
  savingsGoal    SavingsGoal?  @relation(fields: [savingsGoalId], references: [id], onDelete: SetNull)
  recordedBy     User          @relation("RecordedContributions", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([memberId, createdAt])
  @@index([savingsGoalId])
}

model Loan {
  id          String      @id @default(uuid())
  groupId     String
  memberId    String
  amountMinor BigInt
  purpose     String
  status      LoanStatus  @default(PENDING)
  createdAt   DateTime    @default(now())
  decidedAt   DateTime?
  decidedById String?
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  member      GroupMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  decidedBy   User?       @relation("LoanDecisions", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([groupId, status, createdAt])
}

model SavingsGoal {
  id            String         @id @default(uuid())
  groupId       String
  memberId      String?
  title         String         @db.VarChar(80)
  targetMinor   BigInt
  startsAt      DateTime
  deadline      DateTime
  createdAt     DateTime       @default(now())
  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member        GroupMember?   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contributions Contribution[]

  @@index([groupId, deadline])
  @@index([memberId, deadline])
}

model LedgerTransaction {
  id          String        @id @default(uuid())
  groupId     String
  reference   String        @unique
  description String
  currency    String
  amountMinor BigInt
  createdAt   DateTime      @default(now())
  group       Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]

  @@index([groupId, createdAt])
}

model LedgerEntry {
  id            String            @id @default(uuid())
  transactionId String
  account       LedgerAccount
  side          LedgerSide
  amountMinor   BigInt
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([transactionId])
}

model AuditEvent {
  id         String   @id @default(uuid())
  groupId    String
  actorId    String
  action     String
  entityType String
  entityId   String
  createdAt  DateTime @default(now())
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
}
