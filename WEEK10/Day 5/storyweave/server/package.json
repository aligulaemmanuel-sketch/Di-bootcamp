{
  "name": "storyweave-server",
  "version": "1.0.0",
  "description": "Collaborative storytelling app — Express + PostgreSQL + Socket.IO + JWT",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "cloudinary": "2.5.1",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "socket.io": "4.8.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.16.11",
    "@types/supertest": "6.0.2",
    "prisma": "5.20.0",
    "supertest": "7.0.0",
    "tsx": "4.19.1",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
