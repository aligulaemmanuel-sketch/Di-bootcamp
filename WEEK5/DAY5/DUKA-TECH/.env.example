PGHOST=localhost
PGPORT=5432
PGDATABASE=duka_tech
PGUSER=postgres
PGPASSWORD=replace_with_your_pgadmin_password
PORT=4000
SESSION_SECRET=replace_with_a_long_random_value
ADMIN_USERNAME=duka-admin
ADMIN_PASSWORD=replace_with_a_unique_strong_admin_password
# Use a stable random value with at least 32 characters in production.
# Without it, a private local encryption key is generated outside the public web folder.
VERIFICATION_ENCRYPTION_KEY=replace_with_a_stable_random_value_at_least_32_characters_long